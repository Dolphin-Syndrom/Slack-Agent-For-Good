# =============================================================
# ResQ AI — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# ── SLACK (Required) ─────────────────────────────────────────
# Get these from https://api.slack.com/apps → Your App → Basic Info
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# For Socket Mode (local dev — no public URL needed)
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# ── GROQ AI (Required) ───────────────────────────────────────
# Get free API key from https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── WEATHER API (Optional — free tier) ───────────────────────
# Get free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-key-here

# ── NEWS API (Optional — free tier) ──────────────────────────
# Get free key from https://newsapi.org
NEWS_API_KEY=your-newsapi-key-here

# ── APP CONFIGURATION ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
MCP_SERVER_PORT=3001
A2A_SERVER_PORT=3002

# Internal A2A base URL (agents talk to each other here)
A2A_BASE_URL=http://localhost:3002

# MCP server URL
MCP_SERVER_URL=http://localhost:3001

# ── DATABASE ──────────────────────────────────────────────────
# SQLite path (relative to project root)
DB_PATH=./data/resq.db

# ── CRISIS SETTINGS ───────────────────────────────────────────
# How often the Intel Agent polls for new data (minutes)
INTEL_POLL_INTERVAL_MINUTES=5

# Default crisis severity (low | medium | high | critical)
DEFAULT_CRISIS_SEVERITY=high
