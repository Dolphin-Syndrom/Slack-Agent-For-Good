{
  "name": "resq-ai",
  "version": "1.0.0",
  "description": "ResQ AI — Multi-Agent Crisis Response Coordinator for Slack",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
    "start": "node dist/app.js",
    "mcp:start": "ts-node src/mcp/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["slack", "agent", "mcp", "crisis", "ai", "groq"],
  "author": "ResQ AI Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@slack/bolt": "^4.4.0",
    "@slack/web-api": "^7.9.0",
    "axios": "^1.9.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "groq-sdk": "^0.15.0",
    "node-cron": "^3.0.3",
    "uuid": "^11.1.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.21",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
